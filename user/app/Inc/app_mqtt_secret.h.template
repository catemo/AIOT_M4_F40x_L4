/**
 ******************************************************************************
 * @file    app_mqtt_secret.h
 * @brief   本机私有凭证（被 .gitignore 忽略，不入仓库）
 *
 *  使用：复制本模板为 app_mqtt_secret.h（去掉 .template 后缀）再填真实值。
 *        app_mqtt.h 用 __has_include 探测到它后，8 个宏会整体覆盖占位符。
 *  纪律：真实 WiFi 密码 / 设备密钥 / clientId 只允许出现在这个文件里，
 *        不要写回 app_mqtt.h——那是会被推到公开仓库的文件。
 ******************************************************************************
 */
#ifndef APP_MQTT_SECRET_H
#define APP_MQTT_SECRET_H

#define APP_MQTT_WIFI_SSID      "your-wifi-ssid"
#define APP_MQTT_WIFI_PWD       "your-wifi-password"

#define APP_MQTT_BROKER_HOST    "xxxxxxxxxx.iot-mqtts.cn-north-4.myhuaweicloud.com"
#define APP_MQTT_BROKER_PORT    1883

#define APP_MQTT_DEVICE_ID      "your-device-id"
#define APP_MQTT_CLIENT_ID      "your-device-id_0_0_0000000000"
#define APP_MQTT_USERNAME       "your-device-id"
#define APP_MQTT_AUTH_PASSWORD  "your-hmac-password"

#endif /* APP_MQTT_SECRET_H */
